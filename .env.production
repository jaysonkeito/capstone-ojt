# |--------------------------------------------------------------------------
# | OJT Tracker — PRODUCTION environment (MIS Office Ubuntu server)
# |--------------------------------------------------------------------------
# | Copy this file to /opt/ojt-tracker/.env on the server, then fill in the
# | three values marked FILL-IN and run: php artisan key:generate --force
# |
# | Never commit the real .env — this template carries no secrets.

APP_NAME="OJT Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://norsubscojt.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# The database lives in the `db` container — the name "db" is the compose
# service name, not an IP address.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cas_ojt_management
# FILL-IN: the strong password you chose (same value MySQL uses, set in
# docker-compose.yml via this same file's DB_PASSWORD).
DB_USERNAME=ojt
DB_PASSWORD=FILL-IN-STRONG-PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ojt@norsubscojt.online"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Cloud Messaging (push notifications to the Android app) — path to
# the service-account JSON relative to the project root. Leave unset to
# disable pushes until Firebase is set up. See docs/push-notifications.md
FIREBASE_CREDENTIALS=

# Android app distribution — where /download sends phones when no APK is at
# public/downloads/ojt-tracker.apk. Later: the Play Store listing URL.
APP_APK_URL=

# Cloudflare Tunnel (only if the office has no public IP — runbook path B):
# paste the tunnel token from the Cloudflare dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
